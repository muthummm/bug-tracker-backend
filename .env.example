# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net"
# Database name inside the cluster
MONGODB_DB="bugtracker"

# Port for the API (Render sets this automatically)
PORT=3001

# Frontend address(es) allowed to call the API, comma-separated.
# Local dev: http://localhost:5173   Production: e.g. https://bug-tracker-frontend.netlify.app
CORS_ORIGIN="http://localhost:5173"
