# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
# Port for the API (Render sets this automatically)
PORT=3001

# ---------- MongoDB Atlas ----------
# Atlas > Connect > Drivers
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net"
# Database name inside the cluster
MONGODB_DB="bugtracker"

# ---------- CORS ----------
# Frontend address(es) allowed to call the API, comma-separated.
# Local dev: http://localhost:5173   Production: e.g. https://bug-tracker-frontend.netlify.app
CORS_ORIGIN="http://localhost:5173"

# ---------- Cloudinary (screenshot uploads) ----------
# Cloudinary dashboard > Settings > API Keys. Either one URL ...
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
# ... or the three values separately:
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder inside your Cloudinary media library
CLOUDINARY_FOLDER="bug-tracker/screenshots"
