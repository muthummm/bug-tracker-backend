{
  "name": "bug-tracker-backend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Bug Log API: Node.js + Express + MongoDB Atlas (Mongoose) + Cloudinary",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "check": "node --check src/server.js && node -e \"import('./src/app.js').then(m => m.createApp()).then(() => console.log('ok'))\"",
    "import": "node --env-file-if-exists=.env scripts/import-cli.js",
    "migrate:uploads": "node --env-file-if-exists=.env scripts/migrate-uploads.js"
  },
  "dependencies": {
    "cloudinary": "2.11.0",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "express": "4.22.3",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "mongoose": "8.24.8",
    "morgan": "1.12.1",
    "multer": "2.5.0"
  }
}
